FROM python:3.12-slim

WORKDIR /workspace
COPY . .
RUN python -m pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install -e ".[onnx]"

ENTRYPOINT ["python", "-m", "ml_runtime_bench"]
CMD ["suite", "--config", "configs/smoke.json", "--output", "results/container-smoke"]
